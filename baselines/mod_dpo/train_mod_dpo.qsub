#!/bin/bash
#PBS -N rlvib_moddpo
#PBS -P gae50891
#PBS -q rt_HF
#PBS -l select=1
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o rlvib_moddpo.qsub.log

# MoD-DPO / MoD-DPO++ baseline training (see baselines/mod_dpo/README.md).
#   MODEL=qwen3-omni qsub -v MODEL baselines/mod_dpo/train_mod_dpo.qsub            # MoD-DPO
#   MODEL=qwen3-omni PLUS=1 qsub -v MODEL,PLUS baselines/mod_dpo/train_mod_dpo.qsub # MoD-DPO++
set -euo pipefail
cd "$PBS_O_WORKDIR"
mkdir -p "$PBS_O_WORKDIR/runs"
source /home/aab11336im/anaconda3/etc/profile.d/conda.sh
set +u   # rlvib env's activate.d/libstdcxx.sh reads $LD_LIBRARY_PATH unguarded -> set -u aborts
conda activate "${CONDA_ENV:-rlvib}"
set -u
export CUDA_VISIBLE_DEVICES=0
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
export TRANSFORMERS_OFFLINE=1
export PYTHONPATH="$PWD/src:${PYTHONPATH:-}"
echo "=== Node: $(hostname)  Date: $(date) ==="
nvidia-smi -L
TAG="moddpo"; EXTRA=()
[ -n "${PLUS:-}" ] && { TAG="moddpopp"; EXTRA+=(--plus); }
exec > >(tee -a "$PBS_O_WORKDIR/runs/train_${TAG}_${MODEL:-qwen3-omni}_out.txt") 2>&1
python -u baselines/mod_dpo/train_mod_dpo.py --model "${MODEL:-qwen3-omni}" \
    --pairs "${PAIRS:-300}" --epochs "${EPOCHS:-2}" --accum "${ACCUM:-4}" \
    --lr "${LR:-5e-5}" --seed "${SEED:-0}" --eval-every "${EVALEVERY:-10}" \
    ${EXTRA[@]+"${EXTRA[@]}"}
echo "=== Done $(date) ==="
